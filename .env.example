# Local Froodbase stack configuration, read by compose.yaml.
# `make up` copies this file to .env (ignored by git) and fills in the
# password on first run. Every FROODBASE_ variable the stack reads is listed
# here; docs/dev/ops/development.md explains them.

# PostgreSQL role, database and password used by the postgres service and
# in the connection URL given to the api and dreamer. Leave the password
# blank for `make up` to generate a random local one; never commit .env.
FROODBASE_DB_USER=froodbase
FROODBASE_DB_NAME=froodbase
FROODBASE_DB_PASSWORD=

# Host port on 127.0.0.1 where PostgreSQL is published for psql; change it
# if something else already listens on 5432.
FROODBASE_DB_PORT=5432

# Host port on 127.0.0.1 where froodbase-api is published. The health
# endpoint is http://127.0.0.1:<port>/healthz.
FROODBASE_API_PORT=8080

# Host port on 127.0.0.1 where the dreamer's health endpoint is published
# (reports queue depth).
FROODBASE_DREAMER_PORT=8081

# Variables below are set by compose.yaml for the containers and are listed
# for running the binaries outside Compose (for example from bin/).
# Listen address of froodbase-api (default :8080).
#FROODBASE_API_ADDR=:8080
# Health listen address of froodbase-dreamer (default :8081).
#FROODBASE_DREAMER_ADDR=:8081
# Static users file read by froodbase-api (local MVP basic auth). Compose
# mounts local/users.json here; see local/README.md.
#FROODBASE_USERS_FILE=/etc/froodbase/users.json

# Read by froodbase-mcp on the host (not by Compose): the API's MCP endpoint
# and the person's credentials from local/users.json. Set them in the Claude
# Code registration (docs/dev/ops/development.md), not here.
#FROODBASE_API_URL=http://127.0.0.1:8080/mcp
#FROODBASE_USERNAME=alice
#FROODBASE_PASSWORD=froodbase-dev
# PostgreSQL connection URL read by froodbase-api and froodbase-dreamer.
#FROODBASE_DATABASE_URL=postgres://froodbase:<password>@127.0.0.1:5432/froodbase?sslmode=disable
